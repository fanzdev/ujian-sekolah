# ============================================================================
#  SMK AL-FATA CBT — CONTOH ENVIRONMENT
# ----------------------------------------------------------------------------
#  CARA PAKAI:
#    1. Salin file ini menjadi ".env"   (Windows: copy .env.example .env)
#    2. Isi 2 nilai Supabase di bawah.
#    3. Jalankan:  npm install  lalu  npm run dev
#    4. Buka aplikasi → wizard setup akan memandu pembuatan akun admin.
#
#  File ".env" otomatis diabaikan git (lihat .gitignore).
# ============================================================================


# ============================================================================
#  1) SUPABASE — WAJIB DIISI
# ----------------------------------------------------------------------------
#  Diambil dari: dashboard Supabase → Project Settings → API
#  - Project URL  → VITE_SUPABASE_URL
#  - Key "anon" / "public" → VITE_SUPABASE_ANON_KEY
#  Kedua nilai ini PUBLIK dan aman di browser: proteksi data diatur
#  penuh oleh Row Level Security (RLS) di database.
# ============================================================================

# cth: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# cth: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.... (deretan panjang)
VITE_SUPABASE_ANON_KEY=


# ============================================================================
#  2) DILARANG DI FILE INI ❌
# ----------------------------------------------------------------------------
#  SUPABASE_SERVICE_ROLE_KEY=...   ❌ master key, melewati semua RLS!
#  DATABASE_PASSWORD=...           ❌ tidak dibutuhkan frontend
#  VITE_* API KEY AI apa pun      ❌ tidak ada fitur yang butuh API key!
# ============================================================================


# ============================================================================
#  3) ASISTEN LOKAL — TANPA SETUP TAMBAHAN
# ----------------------------------------------------------------------------
#  Semua fitur bantuan (Rekap Otomatis di Laporan, Nilai Otomatis di
#  Penilaian Essay, Draf Pembahasan di Bank Soal) berjalan lokal di
#  browser memakai statistik dan heuristik kata kunci. Tidak perlu
#  deploy Edge Function AI, tidak perlu secrets, tidak perlu API key,
#  dan tetap berfungsi offline selama data sudah termuat.
# ============================================================================
