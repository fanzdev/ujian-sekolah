# ============================================================================
#  SMK AL-FATA CBT — CONTOH FILE ENVIRONMENT
# ----------------------------------------------------------------------------
#  CARA PAKAI:
#    1. Salin file ini menjadi ".env"  (Windows:  copy .env.example .env)
#    2. Isi kedua nilai di BAGIAN 1 di bawah.
#    3. Selesai! File ini TIDAK ikut ter-upload ke Git (diblokir .gitignore).
#
#  ⚠️  ATURAN KEAMANAN:
#    - Hanya variabel berawalan "VITE_" yang masuk ke kode browser.
#    → JANGAN PERNAH menaruh secret/service_role key di file ini.
# ============================================================================


# ============================================================================
#  BAGIAN 1 — WAJIB DIISI (kredensial Supabase Anda)
# ----------------------------------------------------------------------------
#  Sumber nilai:
#    1. Login ke https://supabase.com/dashboard
#    2. Pilih project Anda → klik ikon ⚙️ "Project Settings" (pojok kiri bawah)
#    3. Menu "API"
#    4. Salin:
#       - "Project URL"                → isi VITE_SUPABASE_URL
#       - Key "anon" / "public"        → isi VITE_SUPABASE_ANON_KEY
#
#  Kedua nilai ini PUBLIK dan AMAN untuk frontend, karena seluruh
#  proteksi data dilakukan oleh Row Level Security (RLS) di database.
# ============================================================================

# Contoh format : https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Contoh format : eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.... (deretan panjang)
VITE_SUPABASE_ANON_KEY=


# ============================================================================
#  BAGIAN 2 — JANGAN DILAKUKAN ❌
# ----------------------------------------------------------------------------
#  Jangan menambahkan salah satu baris berikut di file ini:
#    SUPABASE_SERVICE_ROLE_KEY=...   ❌ master key — melewati semua RLS!
#    DATABASE_PASSWORD=...           ❌ password DB tidak dibutuhkan frontend
# ============================================================================
