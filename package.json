{
  "name": "smk-alfata-cbt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SMK AL-FATA CBT - Computer Based Test system (static frontend + Supabase)",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "dev:ngrok": "vite --host 0.0.0.0 --port 5173",
